# Copie para .env.local (desenvolvimento) ou cadastre na Vercel: Settings > Environment Variables.
# Supabase: Project Settings > API (ou Data API).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA (anon ou publishable). Nunca use a service_role aqui.
SUPABASE_ANON_KEY=cole-a-chave-publica-aqui

# Só para a atualização pela IA (scripts/relato.mjs), no computador ou no ambiente do assistente.
# NÃO cadastre na Vercel: o painel não precisa disso. O .env.local não vai para o git.
# RENDERIZA_EMAIL=seu-login-do-painel@exemplo.com
# RENDERIZA_SENHA=
